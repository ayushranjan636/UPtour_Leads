# ─── Postgres ────────────────────────────────────────────
POSTGRES_PASSWORD=change_me_strong_password

# ─── JWT (generate each with: openssl rand -hex 32) ──────
JWT_SECRET=replace_me
JWT_REFRESH_SECRET=replace_me_differently

# ─── OpenWA ──────────────────────────────────────────────
# Must be identical on the openwa and backend services.
OPENWA_API_KEY=replace_me
OPENWA_WEBHOOK_SECRET=replace_me
# The `openwa` entry in this repo is a symlink. Docker cannot use a symlinked
# build context, so point this at the real checkout path.
OPENWA_CONTEXT=../OpenWA

# SQLite keeps OpenWA self-contained, so it will not fight a natively-installed
# Postgres for port 5432 (pair with `docker compose up -d --no-deps openwa`).
# The path lives on the openwa_data volume, so sessions survive restarts.
# Remove both lines for the fully containerised stack (OpenWA then uses Postgres).
OPENWA_DATABASE_TYPE=sqlite
OPENWA_DATABASE_NAME=/app/data/openwa.sqlite

# Where OpenWA should POST WhatsApp events. Applied by scripts/setup-openwa.sh —
# OpenWA itself reads no webhook env vars. Use `backend` when the backend runs in
# compose, `host.docker.internal` when it runs on the host.
OPENWA_WEBHOOK_URL=http://host.docker.internal:3000/api/webhooks/openwa

# OpenWA dashboard login at http://localhost:2785. Without these the dashboard
# only accepts the raw OPENWA_API_KEY as its token.
OPENWA_ADMIN_USERNAME=uptour
OPENWA_ADMIN_PASSWORD=replace_me

# OpenWA is white-labelled for another product by default; this rebrands it.
OPENWA_BRAND_NAME=UP Heritage Tours

# ─── AI ──────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ─── Google Maps (required for Data Collector) ───────────
GOOGLE_MAPS_API_KEY=

# ─── URLs ────────────────────────────────────────────────
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000/api
