# ─── Database ────────────────────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=uptour
DATABASE_USERNAME=uptour
DATABASE_PASSWORD=change_me_local_dev

# ─── Redis (BullMQ queues) ───────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── JWT ─────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-openssl-rand-hex-32
JWT_EXPIRY=15m
JWT_REFRESH_SECRET=replace-with-a-different-openssl-rand-hex-32
JWT_REFRESH_EXPIRY=7d

# ─── OpenWA (WhatsApp gateway) ───────────────────────────
OPENWA_BASE_URL=http://localhost:2785/api
OPENWA_API_KEY=

# Where the gateway should POST events. The gateway runs in Docker, so this must be an
# address reachable *from the container* — localhost there is the container itself, not
# the host. On Docker Desktop that is host.docker.internal; in a compose network it is
# the backend service name.
# Without this, message.ack never arrives and delivered/read rates stay at 0 however many
# messages actually landed.
OPENWA_WEBHOOK_URL=
OPENWA_WEBHOOK_SECRET=
# The session's generated UUID — NOT its name. OpenWA resolves sessions by id
# only, so a friendly value like `default` 404s on every send. After scanning the
# QR, read the real id from:
#   curl -s -H "X-API-Key: $OPENWA_API_KEY" http://localhost:2785/api/sessions
# ../scripts/setup-openwa.sh warns when this value disagrees with the server.
OPENWA_SESSION_ID=

# OpenAI (Primary AI — best model)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Gemini (Fallback AI — auto-switches if OpenAI fails)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ─── Data collection: Google Maps Places API (New) ───────
# REQUIRED for the Data Collector to work at all.
# 1. Create a project at https://console.cloud.google.com/
# 2. Enable the "Places API (New)" service
# 3. Create an API key and restrict it to the Places API
# Billing note: Text Search (New) is billed per request. The scraper requests a
# minimal field mask and spaces calls 2s apart, but set a budget alert anyway.
GOOGLE_MAPS_API_KEY=

# ─── Data collection tuning (optional) ───────────────────
# Milliseconds between Places requests. Lower = faster but costs more per run.
PLACES_THROTTLE_MS=2000

# ─── App ─────────────────────────────────────────────────
APP_PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Browser-reachable gateway URL (OPENWA_BASE_URL may be container-internal).
OPENWA_PUBLIC_URL=http://localhost:2785

# ─── AI auto-reply ───────────────────────────────────────
# Master switch for LLM-composed replies. Off by default.
AI_AUTO_REPLY_ENABLED=false

# ─── Humanised send pacing ───────────────────────────────
# Inter-message gaps are drawn uniformly from this range (milliseconds).
HUMANIZED_DELAY_MIN_MS=45000
HUMANIZED_DELAY_MAX_MS=180000
