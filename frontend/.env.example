# Backend API base URL, including the /api prefix.
# Copy this file to `.env` and adjust if your backend is not on localhost:3000.
VITE_API_URL=http://localhost:3000/api

# WhatsApp gateway's own web portal, linked from Settings → WhatsApp.
# Used only for deep session admin (logs, multi-session, message debugging);
# day-to-day pairing happens in this portal. Defaults to localhost:2785.
VITE_OPENWA_URL=http://localhost:2785
